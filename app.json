    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.go.sdrs.mobile"
    },
    "android": {
      "package": "kr.go.sdrs.mobile"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
