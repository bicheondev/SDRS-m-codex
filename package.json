{
  "name": "sdrs-expo-native",
  "private": true,
  "version": "1.0.0",
  "main": "App.js",
  "scripts": {
    "audit:browser-apis": "node scripts/audit-browser-apis.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "audit:dom": "node scripts/audit-dom-removal.mjs",
    "android": "expo start --android",
    "build": "expo export",
    "check:bundled-data": "npm run audit:data",
    "check:dom": "npm run audit:dom",
    "check:native-readiness": "node scripts/check-native-readiness.mjs",
    "dev": "expo start",
    "export:android": "expo export --platform android",
    "preview": "expo start",
    "start": "expo start",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "validate": "npm run audit:dom && npm run audit:data && npm run audit:browser-apis && npm run test:run && npm run export:android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "es-hangul": "^2.3.8",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "^3.0.0",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/cli": "^54.0.24",
    "babel-preset-expo": "~54.0.10",
    "vitest": "^3.1.2"
  }
}
